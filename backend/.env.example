PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=preva
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Stripe Checkout: run Stripe CLI with
# stripe listen --forward-to http://localhost:4000/api/stripe/webhook
# and place the CLI-provided whsec_ signing secret below.
# For production, replace the site URL and webhook endpoint with public HTTPS URLs.
# Enable these live webhook events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, payment_intent.payment_failed, charge.refunded,
# refund.created, refund.updated, and refund.failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNPAID_TEST_ORDERS=false

# Optional Google reviews integration.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
GOOGLE_REVIEWS_SOURCE_URL=
