NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://prevakitchen.com,https://www.prevakitchen.com
TRUST_PROXY=true
MONGODB_URI=
MONGODB_DB=preva
JWT_SECRET=
NEXT_PUBLIC_SITE_URL=https://prevakitchen.com

# Local Stripe Checkout: run Stripe CLI with
# stripe listen --forward-to http://localhost:4000/api/stripe/webhook
# and place the CLI-provided whsec_ signing secret below.
# For production, replace the site URL and webhook endpoint with public HTTPS URLs.
# Enable these live webhook events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, payment_intent.payment_failed, charge.refunded,
# refund.created, refund.updated, and refund.failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNPAID_TEST_ORDERS=false

# Optional Google reviews integration.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJF5z-j1-1JIgR3tZAujO2mZI
GOOGLE_PLACE_QUERY=Preva Kitchen, 13090 Inkster Rd, Redford Township, MI 48239
GOOGLE_REVIEWS_SOURCE_URL=https://prevakitchen.com/

# ── Transactional email notifications (Resend) ────────────────────
# Create an API key and verify the sending domain at https://resend.com.
RESEND_API_KEY=
FROM_EMAIL=PREVA Kitchen <no-reply@prevaclub.com>
# Default recipient for all form notifications (reservation, contact, career).
# A comma-separated list is accepted.
ADMIN_EMAIL=reservations@prevaclub.com
ADMIN_EMAILS=reservations@prevaclub.com
# Optional route-specific overrides. When blank they fall back to ADMIN_EMAIL.
RESERVATION_ADMIN_EMAIL=reservations@prevaclub.com
CAREER_ADMIN_EMAIL=reservations@prevaclub.com
HR_EMAIL=
# Legacy aliases remain supported for existing deployments:
# STAFF_ALERT_EMAIL=
# STAFF_EMAIL_FROM=
ADMIN_URL=https://prevakitchen.com/admin
# Customer-facing links in confirmation emails (track order, etc) resolve
# against this. Defaults to prevakitchen.com if unset.
STOREFRONT_URL=https://prevakitchen.com
# Local/staging only: when set and NODE_ENV isn't "production", every email
# (admin AND customer) is redirected here instead of the real address, so
# testing never reaches a real customer's inbox.
MAIL_CATCH_ALL=
