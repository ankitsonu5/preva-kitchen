NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://prevakitchen.com,https://www.prevakitchen.com
TRUST_PROXY=true
MONGODB_URI=
MONGODB_DB=preva
JWT_SECRET=

NEXT_PUBLIC_SITE_URL=https://prevakitchen.com

# Local Stripe Checkout: run Stripe CLI with
# stripe listen --forward-to http://localhost:4000/api/stripe/webhook
# and place the CLI-provided whsec_ signing secret below.
# For production, replace the site URL and webhook endpoint with public HTTPS URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNPAID_TEST_ORDERS=false

# ── Nodemailer SMTP Email Notifications ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Preva Kitchen <reservations@prevakitchen.com>
# Career page forms use their own mailbox (Gmail App Password); recipients and sender are fixed to careers@.
CAREER_SMTP_PASS=

# Form-specific recipient routing:
# Reservation submissions → reservations@prevakitchen.com
RESERVATION_EMAIL=reservations@prevakitchen.com
# Contact submissions → info@prevakitchen.com
CONTACT_EMAIL=info@prevakitchen.com
ADMIN_EMAIL=reservations@prevakitchen.com
ADMIN_EMAILS=reservations@prevakitchen.com
RESERVATION_ADMIN_EMAIL=reservations@prevakitchen.com
ADMIN_URL=https://prevakitchen.com/admin
STOREFRONT_URL=https://prevakitchen.com

# Local/staging only: when set and NODE_ENV isn't "production", every email
# is redirected here. Leave empty in production or to deliver to actual recipients.
MAIL_CATCH_ALL=
