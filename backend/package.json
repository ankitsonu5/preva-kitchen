{
  "name": "preva-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "clean:pages": "node scripts/seed-site-pages.js",
    "sync:dish-details": "node scripts/sync-live-dish-details.js",
    "sync:dish-details:fallback": "node scripts/sync-dish-details.js",
    "migrate:legacy-images": "node scripts/migrate-legacy-images.js",
    "update:blog-links": "node scripts/update-blog-links.js",
    "sync:wordpress": "node scripts/seed-landing-pages.js && node scripts/sync-live-wordpress.js && node scripts/migrate-legacy-images.js",
    "sync:posts": "node scripts/sync-posts.js && node scripts/migrate-legacy-images.js",
    "first-admin": "node scripts/first-admin.js",
    "ensure-admin": "node scripts/ensure-admin.js",
    "audit:production": "node scripts/audit-production.js",
    "routes": "node -e \"import('./src/index.js').then(m=>console.log(m.listRoutes().join('\\n')))\"",
    "verify:payments:local": "node scripts/verify-payment-local.js",
    "verify:email": "node scripts/verify-email.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pdfkit": "^0.15.2",
    "resend": "^6.27.0",
    "sanitize-html": "^2.17.0",
    "slugify": "^1.6.6",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  }
}
