# ═══════════════ PREVA FRONTEND ═══════════════
# Copy to .env.local and fill in. The backend has its OWN .env — keep them
# separate.

# Where the backend API service runs. Used by:
#  - the /api/* rewrite proxy (browser requests)
#  - server components fetching CMS data during render
# The current production nginx routes /api directly to the Express backend.
BACKEND_URL=https://prevakitchen.com

# Public origins are baked into the Next.js build. Rebuild after changing them.
NEXT_PUBLIC_CANONICAL_URL=https://prevakitchen.com
NEXT_PUBLIC_SITE_URL=https://prevakitchen.com

# Stripe Checkout is hosted by Stripe and currently needs no browser SDK.
# Keep the publishable key here for Stripe-managed frontend features if added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Nodemailer SMTP Email Integration ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Preva Kitchen <reservations@prevakitchen.com>
RESERVATION_EMAIL=reservations@prevakitchen.com
CONTACT_EMAIL=info@prevakitchen.com
CAREER_EMAIL=donnaw@prevaclub.com
